# ===== Bắt buộc =====
# Kết nối MySQL (Hostinger: hPanel → Databases → MySQL Databases)
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME

# Địa chỉ website (dùng cho SEO, sitemap)
SITE_URL=https://phuquocmedia.vn

# Tài khoản đăng nhập trang /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dat-mat-khau-manh-o-day

# Chuỗi bí mật ngẫu nhiên (>= 32 ký tự) để ký phiên đăng nhập
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Thư mục lưu ảnh/video tải lên từ Admin. Nên đặt NGOÀI thư mục code
# để không bị mất khi deploy lại, vd: /home/u123456789/pqm-uploads
UPLOAD_DIR=

# ===== Email thông báo khi có yêu cầu báo giá (tùy chọn) =====
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=phuquocmediavn@gmail.com
SMTP_PASS=
MAIL_TO=phuquocmediavn@gmail.com

# ===== Thư viện ảnh từ fanpage Facebook (tùy chọn) =====
# Page ID và Page Access Token dài hạn của fanpage (xem README).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ===== Telegram thông báo (tùy chọn) =====
# Tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
